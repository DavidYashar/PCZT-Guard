{
  "name": "pczt-guard-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PCZT Guard in the browser: drop a PCZT, get a verdict. Nothing leaves the page.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "wasm": "wasm-pack build ../crates/pczt-guard-wasm --target web --out-dir ../../web-demo/src/wasm --out-name pczt_guard_wasm",
    "fixtures": "cargo run --manifest-path ../Cargo.toml -p xtask -- fixtures public/fixtures"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
